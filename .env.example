# All settings are optional; these are the defaults.
REVIEW_ANALYZER_DATABASE_URL=sqlite:///data/reviews.db
REVIEW_ANALYZER_LANGUAGE=en
REVIEW_ANALYZER_COUNTRY=us

# Play Store fetching. The hosted demo tightens these (see deploy/streamlit).
REVIEW_ANALYZER_SYNC_TTL_MINUTES=360
REVIEW_ANALYZER_MAX_SYNC_COUNT=1000
# REVIEW_ANALYZER_MAX_SYNCS_PER_HOUR=30
# REVIEW_ANALYZER_PRELOAD_APPS=["com.spotify.music", "com.whatsapp"]
REVIEW_ANALYZER_PRELOAD_COUNT=200

# Models are used only when the `ml` extra is installed.
REVIEW_ANALYZER_ENABLE_ML=true
REVIEW_ANALYZER_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
REVIEW_ANALYZER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Streamlit UI only, and read from the environment rather than this file: when set,
# the UI calls this API instead of running the analysis in-process.
# REVIEW_ANALYZER_API_URL=http://localhost:8000
